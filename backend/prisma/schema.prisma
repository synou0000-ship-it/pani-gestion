generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           Int           @id @default(autoincrement())
  nom          String        @unique
  description  String?
  utilisateurs Utilisateur[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Utilisateur {
  id               Int               @id @default(autoincrement())
  nom              String
  prenom           String
  email            String            @unique
  telephone        String?
  motDePasse       String
  actif            Boolean           @default(true)
  roleId           Int
  role             Role              @relation(fields: [roleId], references: [id])
  ventes           Vente[]
  achats           Achat[]
  depenses         Depense[]
  mouvementsCaisse MouvementCaisse[]
  caisses          Caisse[]
  inventaires      Inventaire[]
  auditLogs        JournalAudit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Produit {
  id                Int                @id @default(autoincrement())
  nom               String
  description       String?
  unite             String             @default("unité")
  actif             Boolean            @default(true)
  tarifs            Tarif[]
  venteDetails      VenteDetail[]
  achatDetails      AchatDetail[]
  mouvementsStock   MouvementStock[]
  inventaireDetails InventaireDetail[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Tarif {
  id           Int           @id @default(autoincrement())
  produitId    Int
  produit      Produit       @relation(fields: [produitId], references: [id])
  designation  String
  prix         Decimal       @db.Decimal(15, 2)
  actif        Boolean       @default(true)
  venteDetails VenteDetail[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id         Int              @id @default(autoincrement())
  nom        String
  prenom     String?
  telephone  String?
  adresse    String?
  email      String?
  typeClient String           @default("particulier")
  actif      Boolean          @default(true)
  ventes     Vente[]
  paiements  PaiementClient[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Fournisseur {
  id        Int                   @id @default(autoincrement())
  nom       String
  contact   String?
  telephone String?
  adresse   String?
  email     String?
  actif     Boolean               @default(true)
  achats    Achat[]
  paiements PaiementFournisseur[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model Vente {
  id              Int              @id @default(autoincrement())
  reference       String           @unique
  clientId        Int?
  client          Client?          @relation(fields: [clientId], references: [id])
  utilisateurId   Int
  utilisateur     Utilisateur      @relation(fields: [utilisateurId], references: [id])
  dateVente       DateTime         @default(now())
  montantTotal    Decimal          @db.Decimal(15, 2)
  montantPaye     Decimal          @db.Decimal(15, 2) @default(0)
  resteAPayer     Decimal          @db.Decimal(15, 2) @default(0)
  statut          String           @default("validee")
  notes           String?
  details         VenteDetail[]
  paiements       PaiementClient[]
  mouvementsStock MouvementStock[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model VenteDetail {
  id           Int      @id @default(autoincrement())
  venteId      Int
  vente        Vente    @relation(fields: [venteId], references: [id])
  produitId    Int
  produit      Produit  @relation(fields: [produitId], references: [id])
  tarifId      Int
  tarif        Tarif    @relation(fields: [tarifId], references: [id])
  quantite     Decimal  @db.Decimal(15, 3)
  prixUnitaire Decimal  @db.Decimal(15, 2)
  montant      Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
}

model PaiementClient {
  id                Int              @id @default(autoincrement())
  venteId           Int?
  vente             Vente?           @relation(fields: [venteId], references: [id])
  clientId          Int
  client            Client           @relation(fields: [clientId], references: [id])
  montant           Decimal          @db.Decimal(15, 2)
  modePaiement      String           @default("especes")
  datePaiement      DateTime         @default(now())
  notes             String?
  mouvementCaisseId Int?
  mouvementCaisse   MouvementCaisse? @relation(fields: [mouvementCaisseId], references: [id])
  createdAt         DateTime         @default(now())
}

model Achat {
  id              Int                   @id @default(autoincrement())
  reference       String                @unique
  fournisseurId   Int
  fournisseur     Fournisseur           @relation(fields: [fournisseurId], references: [id])
  utilisateurId   Int
  utilisateur     Utilisateur           @relation(fields: [utilisateurId], references: [id])
  dateAchat       DateTime              @default(now())
  montantTotal    Decimal               @db.Decimal(15, 2)
  montantPaye     Decimal               @db.Decimal(15, 2) @default(0)
  resteAPayer     Decimal               @db.Decimal(15, 2) @default(0)
  statut          String                @default("receptionne")
  notes           String?
  details         AchatDetail[]
  paiements       PaiementFournisseur[]
  mouvementsStock MouvementStock[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model AchatDetail {
  id           Int      @id @default(autoincrement())
  achatId      Int
  achat        Achat    @relation(fields: [achatId], references: [id])
  produitId    Int
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Decimal  @db.Decimal(15, 3)
  prixUnitaire Decimal  @db.Decimal(15, 2)
  montant      Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
}

model PaiementFournisseur {
  id                Int              @id @default(autoincrement())
  achatId           Int?
  achat             Achat?           @relation(fields: [achatId], references: [id])
  fournisseurId     Int
  fournisseur       Fournisseur      @relation(fields: [fournisseurId], references: [id])
  montant           Decimal          @db.Decimal(15, 2)
  modePaiement      String           @default("especes")
  datePaiement      DateTime         @default(now())
  notes             String?
  mouvementCaisseId Int?
  mouvementCaisse   MouvementCaisse? @relation(fields: [mouvementCaisseId], references: [id])
  createdAt         DateTime         @default(now())
}

model MouvementStock {
  id            Int        @id @default(autoincrement())
  produitId     Int
  produit       Produit    @relation(fields: [produitId], references: [id])
  typeOperation String
  quantite      Decimal    @db.Decimal(15, 3)
  stockAvant    Decimal    @db.Decimal(15, 3)
  stockApres    Decimal    @db.Decimal(15, 3)
  motif         String?
  venteId       Int?
  vente         Vente?     @relation(fields: [venteId], references: [id])
  achatId       Int?
  achat         Achat?     @relation(fields: [achatId], references: [id])
  inventaireId  Int?
  inventaire    Inventaire? @relation(fields: [inventaireId], references: [id])
  dateMouvement DateTime   @default(now())
  createdAt     DateTime   @default(now())
}

model Inventaire {
  id              Int                @id @default(autoincrement())
  reference       String             @unique
  utilisateurId   Int
  utilisateur     Utilisateur        @relation(fields: [utilisateurId], references: [id])
  dateInventaire  DateTime           @default(now())
  statut          String             @default("en_cours")
  notes           String?
  details         InventaireDetail[]
  mouvementsStock MouvementStock[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model InventaireDetail {
  id             Int        @id @default(autoincrement())
  inventaireId   Int
  inventaire     Inventaire @relation(fields: [inventaireId], references: [id])
  produitId      Int
  produit        Produit    @relation(fields: [produitId], references: [id])
  stockTheorique Decimal    @db.Decimal(15, 3)
  stockPhysique  Decimal    @db.Decimal(15, 3)
  ecart          Decimal    @db.Decimal(15, 3)
  motifEcart     String?
  createdAt      DateTime   @default(now())
}

model Caisse {
  id              Int               @id @default(autoincrement())
  reference       String            @unique
  utilisateurId   Int
  utilisateur     Utilisateur       @relation(fields: [utilisateurId], references: [id])
  dateOuverture   DateTime          @default(now())
  dateCloture     DateTime?
  soldeInitial    Decimal           @db.Decimal(15, 2)
  soldeTheorique  Decimal           @db.Decimal(15, 2) @default(0)
  soldeReel       Decimal?          @db.Decimal(15, 2)
  ecart           Decimal?          @db.Decimal(15, 2)
  statut          String            @default("ouverte")
  notes           String?
  mouvements      MouvementCaisse[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MouvementCaisse {
  id                    Int                   @id @default(autoincrement())
  caisseId              Int
  caisse                Caisse                @relation(fields: [caisseId], references: [id])
  utilisateurId         Int
  utilisateur           Utilisateur           @relation(fields: [utilisateurId], references: [id])
  typeOperation         String
  montant               Decimal               @db.Decimal(15, 2)
  soldeAvant            Decimal               @db.Decimal(15, 2)
  soldeApres            Decimal               @db.Decimal(15, 2)
  description           String?
  dateMouvement         DateTime              @default(now())
  paiementsClients      PaiementClient[]
  paiementsFournisseurs PaiementFournisseur[]
  depenses              Depense[]
  createdAt             DateTime              @default(now())
}

model Depense {
  id                Int            @id @default(autoincrement())
  numero            String         @unique
  utilisateurId     Int
  utilisateur       Utilisateur    @relation(fields: [utilisateurId], references: [id])
  categorie         String
  description       String
  montant           Decimal        @db.Decimal(15, 2)
  modePaiement      String         @default("especes")
  beneficiaire      String?
  dateDepense       DateTime       @default(now())
  notes             String?
  hasJustificatif   Boolean        @default(false)
  mouvementCaisseId Int?
  mouvementCaisse   MouvementCaisse? @relation(fields: [mouvementCaisseId], references: [id])
  justificatifs     Justificatif[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Justificatif {
  id            Int      @id @default(autoincrement())
  depenseId     Int
  depense       Depense  @relation(fields: [depenseId], references: [id])
  nomFichier    String
  cheminFichier String
  typeFichier   String
  tailleFichier Int
  createdAt     DateTime @default(now())
}

model JournalAudit {
  id               Int          @id @default(autoincrement())
  utilisateurId    Int?
  utilisateur      Utilisateur? @relation(fields: [utilisateurId], references: [id])
  action           String
  table            String
  enregistrementId Int?
  anciennesValeurs Json?
  nouvellesValeurs Json?
  adresseIp        String?
  createdAt        DateTime     @default(now())
}
